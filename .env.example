# SkinTrack Environment Configuration

# Frontend URL (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# JWT secret key
JWT_SECRET=skintrack-dev-secret-change-in-prod

# Cloud Email Delivery via Resend API (Recommended for production on Render)
# Sign up free at https://resend.com and paste your API key here:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# SMTP Configuration for Real Emails (Alternative)
# If left blank, the server automatically uses Ethereal test inbox and console links for development.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
